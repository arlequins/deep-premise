; Unseen Order — native Godot desktop project. No web export or embedded browser.
config_version=5

[application]
config/name="Unseen Order"
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://game/assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="UnseenOrder"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.052, 0.083, 0.091, 1)

[application_run]
low_processor_usage_mode=true
